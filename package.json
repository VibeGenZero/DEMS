{
  "name": "dems",
  "version": "2.6.0",
  "description": "Discord Event Management System",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:mock": "nodemon dev/start.js",
    "dev:reset": "node dev/reset.js",
    "test": "node --test \"test/**/*.test.js\"",
    "wiki": "node scripts/wiki-graph.js",
    "wiki:check": "node scripts/wiki-graph.js --check"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "firebase": "^12.19.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "ignore": [
      "data/**",
      "public/**",
      "docs/**",
      "landing/**",
      "test/**"
    ]
  }
}
