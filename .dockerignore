.git/
.gitignore
.gitattributes
.idea/
.vscode/
.claude/
docs/
scripts/
test/
landing/
ci/
.gitlab-ci.yml
*.md
logs/
*.log

# Docker files themselves
Dockerfile
.dockerignore
compose*.yaml
docker-compose*.yml
