# Discord Application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional: Custom Server Name (overrides Discord API server name if set)
SERVER_NAME=

# Optional: Admin Role ID (users with this Discord role can manage events)
DISCORD_ADMIN_ROLE_ID=

# Channel for event announcements
DISCORD_ANNOUNCE_CHANNEL_ID=

# Category where auto-voice channels will be created
DISCORD_EVENT_CATEGORY_ID=

# Firebase (OPTIONAL)
# Wenn ALLE FIREBASE_*-Werte gesetzt sind, wird Firebase Firestore genutzt.
# Wenn sie ALLE leer bleiben, nutzt DEMS automatisch eine lokale SQLite-Datenbank.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# SQLite (nur relevant, wenn kein Firebase konfiguriert ist)
# Pfad zur lokalen Datenbankdatei (Standard: ./data/dems.sqlite)
# Unter Docker wird der Wert von compose.yaml auf /app/data/dems.sqlite gesetzt.
SQLITE_PATH=./data/dems.sqlite

# Session (REQUIRED)
SESSION_SECRET=

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Docker: Port auf dem Host (compose.yaml). Im Container läuft DEMS immer auf 3000.
DEMS_PORT=3000

# Timezone for event dates (IANA format, default: Europe/Berlin)
TIMEZONE=Europe/Berlin

# Debug mode — logs all HTTP requests, Firebase ops, and bot calls to terminal
# Set to true only in development. Never enable in production.
DEBUG_MODE=false

# Reset PW
ADMIN_RESET_PASSWORD=

# Dev-Mock-Modus: DEMS ohne Discord/Firebase mit Dummy-Daten (npm run dev:mock)
# npm run dev:mock setzt DEV_MOCK selbst — hier nur eintragen, wenn du den Modus
# auch mit "npm run dev" willst. Niemals in Produktion: mit NODE_ENV=production
# startet der Server dann nicht.
# Achtung: nur "npm run dev:mock" legt die Dummy-Daten automatisch an; mit
# "npm run dev" + DEV_MOCK=true vorher einmal "npm run dev:reset" ausführen.
# DEV_MOCK=true
# Optional: eigener Pfad für die Dev-Datenbank (Standard: ./data/dems.dev.sqlite)
# DEV_SQLITE_PATH=

# Docker-Dev: Port auf dem Host (compose.dev.yaml)
# DEMS_DEV_PORT=3000
