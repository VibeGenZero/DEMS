# Discord Application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional: Custom Server Name (overrides Discord API server name if set)
SERVER_NAME=

# Optional: Admin Role ID (users with this Discord role can manage events)
DISCORD_ADMIN_ROLE_ID=

# Channel for event announcements
DISCORD_ANNOUNCE_CHANNEL_ID=

# Category where auto-voice channels will be created
DISCORD_EVENT_CATEGORY_ID=

# Optional: Kommentare der Event-Seite mit dem Discord-Diskussions-Thread spiegeln (B-16)
# true = Web-Kommentare erscheinen im Thread (per Webhook, den der Bot selbst anlegt), Thread-Nachrichten auf der Website.
# VORHER im Discord Developer Portal unter Bot den "Message Content Intent" einschalten,
# sonst lehnt Discord den Login ab und der Bot bleibt offline ("Used disallowed intents").
# Der Bot braucht dazu die Rechte "Webhooks verwalten" und "Nachrichten verwalten".
# Leer lassen = aus (Standard). Im Mock-Modus automatisch an.
DISCORD_THREAD_SYNC=

# Datenbank (PostgreSQL)
# Mit docker compose (compose.yaml) ist hier NICHTS zu tun: Compose startet PostgreSQL,
# erzeugt beim ersten Start ein zufälliges Passwort und setzt PGHOST & Co. selbst.
# Nur für einen eigenen PostgreSQL-Server ohne Compose ausfüllen, entweder als URL ...
# DATABASE_URL=postgres://dems:passwort@host:5432/dems
# ... oder als Einzelwerte (DATABASE_URL hat Vorrang):
# PGHOST=
# PGPORT=5432
# PGDATABASE=dems
# PGUSER=dems
# PGPASSWORD=
# Alternativ zu PGPASSWORD: Datei, die nur das Passwort enthält
# PGPASSWORD_FILE=
# In Produktion (NODE_ENV=production) startet DEMS ohne PostgreSQL nicht.

# SQLite (nur Entwicklung und Tests)
# Ohne PostgreSQL-Werte nutzt DEMS außerhalb der Produktion diese lokale Datei.
# Pfad zur Datenbankdatei (Standard: ./data/dems.sqlite)
SQLITE_PATH=./data/dems.sqlite

# Hochgeladene Banner (Ordner, darunter liegt banners/; Standard: ./data/uploads)
# Unter Docker liegt ./data/uploads im Volume /app/data -> Banner überleben ein Update.
# Die Bilder liegen immer auf der lokalen Platte, nicht in der Datenbank.
# UPLOAD_DIR=./data/uploads

# Session (REQUIRED)
SESSION_SECRET=

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Docker: Port auf dem Host (compose.yaml). Im Container läuft DEMS immer auf 3000.
DEMS_PORT=3000

# Timezone for event dates (IANA format, default: Europe/Berlin)
TIMEZONE=Europe/Berlin

# Debug mode — logs all HTTP requests, Firebase ops, and bot calls to terminal
# Set to true only in development. Never enable in production.
DEBUG_MODE=false

# Reset PW
ADMIN_RESET_PASSWORD=

# Dev-Mock-Modus: DEMS ohne Discord/Firebase mit Dummy-Daten (npm run dev:mock)
# npm run dev:mock setzt DEV_MOCK selbst — hier nur eintragen, wenn du den Modus
# auch mit "npm run dev" willst. Niemals in Produktion: mit NODE_ENV=production
# startet der Server dann nicht.
# Achtung: nur "npm run dev:mock" legt die Dummy-Daten automatisch an; mit
# "npm run dev" + DEV_MOCK=true vorher einmal "npm run dev:reset" ausführen.
# DEV_MOCK=true
# Optional: eigener Pfad für die Dev-Datenbank (Standard: ./data/dems.dev.sqlite)
# DEV_SQLITE_PATH=
# Optional: eigener Ordner für hochgeladene Banner im Mock-Modus (Standard: ./data/dev-uploads)
# DEV_UPLOAD_DIR=

# Docker-Dev: Port auf dem Host (compose.dev.yaml)
# DEMS_DEV_PORT=3000
