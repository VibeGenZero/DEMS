# Ohne .env geht es auch: DEMS startet dann den Einrichtungsassistenten im Browser und speichert
# Discord-Werte, Server-Name, BASE_URL, Zeitzone und Admin-Reset-Passwort in der Datenbank.
# Ein hier gesetzter Wert hat immer Vorrang und ist im Assistenten und unter Admin > System gesperrt.

# Discord-Anwendung (Discord Developer Portal): Client-ID und -Secret für den Login,
# Bot-Token für den Bot, Guild-ID = ID deines Discord-Servers
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional: eigener Server-Name in der Oberfläche (leer = Name des Discord-Servers)
SERVER_NAME=

# Optional: ID der Admin-Rolle (Mitglieder mit dieser Rolle verwalten DEMS).
# Wer auf dem Server die Berechtigung „Administrator“ hat (auch der Eigentümer), ist immer Admin.
DISCORD_ADMIN_ROLE_ID=

# Kanal, in dem der Bot neue Events ankündigt
DISCORD_ANNOUNCE_CHANNEL_ID=

# Kategorie, in der der Bot die Sprachkanäle für Events anlegt
DISCORD_EVENT_CATEGORY_ID=

# Optional: Kommentare der Event-Seite mit dem Discord-Diskussions-Thread spiegeln (B-16)
# true = Web-Kommentare erscheinen im Thread (per Webhook, den der Bot selbst anlegt), Thread-Nachrichten auf der Website.
# VORHER im Discord Developer Portal unter Bot den "Message Content Intent" einschalten,
# sonst lehnt Discord den Login ab und der Bot bleibt offline ("Used disallowed intents").
# Der Bot braucht dazu die Rechte "Webhooks verwalten" und "Nachrichten verwalten".
# Leer lassen = aus (Standard). Im Mock-Modus automatisch an.
DISCORD_THREAD_SYNC=

# Datenbank (PostgreSQL)
# Mit docker compose (compose.yaml) ist hier NICHTS zu tun: Compose startet PostgreSQL,
# erzeugt beim ersten Start ein zufälliges Passwort und setzt PGHOST & Co. selbst.
# Nur für einen eigenen PostgreSQL-Server ohne Compose ausfüllen, entweder als URL ...
# DATABASE_URL=postgres://dems:passwort@host:5432/dems
# ... oder als Einzelwerte (DATABASE_URL hat Vorrang):
# PGHOST=
# PGPORT=5432
# PGDATABASE=dems
# PGUSER=dems
# PGPASSWORD=
# Alternativ zu PGPASSWORD: Datei, die nur das Passwort enthält
# PGPASSWORD_FILE=
# Ohne PostgreSQL-Werte nutzt DEMS die eingebaute Datenbank (SQLite, siehe unten).

# SQLite (eingebaute Datenbank: einzelner Container, Entwicklung und Tests)
# Ohne PostgreSQL-Werte nutzt DEMS diese lokale Datei – auch in Produktion.
# Im Docker-Image liegt sie unter /app/data; dafür ein Volume einhängen (-v dems-data:/app/data).
# Pfad zur Datenbankdatei (Standard: ./data/dems.sqlite)
SQLITE_PATH=./data/dems.sqlite

# Hochgeladene Banner (Ordner, darunter liegt banners/; Standard: ./data/uploads)
# Unter Docker liegt ./data/uploads im Volume /app/data -> Banner überleben ein Update.
# Die Bilder liegen immer auf der lokalen Platte, nicht in der Datenbank.
# UPLOAD_DIR=./data/uploads

# Session
# Leer lassen = DEMS erzeugt beim ersten Start ein zufälliges Secret und speichert es in der Datenbank.
# Wer es selbst setzt: z. B. openssl rand -hex 32. Eine Änderung meldet alle ab.
SESSION_SECRET=

# Einrichtungsassistent (nur solange DEMS noch nicht eingerichtet ist)
# Leer lassen = DEMS erzeugt bei jedem Start eine neue 8-stellige PIN und schreibt sie ins Log
# (docker compose logs dems). Die PIN öffnet den Assistenten im Browser; nach der Einrichtung gilt sie nicht mehr.
# SETUP_PIN=

# Server: Port im Prozess und öffentliche Adresse (für Links in Discord und den OAuth-Redirect)
PORT=3000
BASE_URL=http://localhost:3000

# Betriebsart. Das Docker-Image setzt production selbst – hier nur eintragen, wenn DEMS
# ohne Docker produktiv läuft. production macht die Cookies „Secure“: DEMS muss dann über
# HTTPS erreichbar sein (TLS-Proxy mit X-Forwarded-Proto: https), sonst hält der Login nicht.
# Mit production startet der Dev-Mock-Modus nicht.
# NODE_ENV=production

# Optional: Anfragen an /api pro 15 Minuten. Eingeloggte zählen pro Person (Standard 1000),
# alle anderen pro IP-Adresse (Standard 200). Im Dev-Mock-Modus gibt es kein Limit.
# RATE_LIMIT_MAX_USER=1000
# RATE_LIMIT_MAX=200

# Optional: welchem Proxy DEMS die Client-Adresse (X-Forwarded-For) glaubt. Leer lassen =
# genau ein Proxy, und nur wenn er von Loopback oder einer privaten Adresse kommt (Reverse-Proxy
# auf demselben Host oder im Docker-Netz). false = kein Proxy, eine Zahl = so viele Proxys
# hintereinander, sonst eine Liste von Proxy-Adressen (z. B. loopback, 10.0.0.0/8).
# Plattformen, deren Proxy keine private Adresse hat, setzen TRUST_PROXY=1.
# TRUST_PROXY=

# Docker: Port auf dem Host (compose.yaml). Im Container läuft DEMS immer auf 3000.
DEMS_PORT=3000

# Docker: an welcher Host-Adresse der Port lauscht (compose.yaml). Standard: nur auf dem Host
# selbst (127.0.0.1), der TLS-Proxy läuft dort oder im Docker-Netz. Läuft der Proxy auf einem
# anderen Rechner: DEMS_BIND=0.0.0.0
# DEMS_BIND=127.0.0.1

# Docker: welches Image compose.yaml zieht. latest = fertige Releases (Standard),
# beta = Vorabversionen (Beta, Release Candidate). Danach: docker compose pull && docker compose up -d
# DEMS_TAG=latest

# Zeitzone für Event-Zeiten in Bot-Nachrichten (IANA-Format, Standard: Europe/Berlin)
TIMEZONE=Europe/Berlin

# Update-Prüfung: DEMS fragt 30 Sekunden nach dem Start und dann alle 12 Stunden die
# öffentlichen GitHub-Releases ab und zeigt Admins unter „System“, wenn es eine neuere
# Version gibt. Gesendet wird nur eine einfache Anfrage von der IP des Servers an GitHub,
# nichts über deine Installation. Mit false abschalten (z. B. ohne Internetzugang).
# UPDATE_CHECK=false
# Optional: eigenes GitHub-Repo (owner/repo) für Forks, Standard: VibeGenZero/DEMS
# UPDATE_CHECK_REPO=VibeGenZero/DEMS

# Debug-Modus: schreibt alle HTTP-Anfragen, Datenbankzugriffe und Bot-Aufrufe ins Terminal
# und zeigt den Bereich #debug. Nur in der Entwicklung auf true setzen, niemals in Produktion.
DEBUG_MODE=false

# Admin-Reset-Passwort: bestätigt besonders kritische Aktionen – System zurücksetzen,
# Panikmodus beenden, ein nicht offizielles Plugin einschalten, Plugins hochladen und
# entfernen, geheime Plugin-Einstellungen ändern. Leer = diese Aktionen sind nicht möglich.
# Ein langes, eigenes Passwort wählen (nicht das Discord-Passwort).
ADMIN_RESET_PASSWORD=

# Plugins
# Ordner für eigene Plugins (nicht offiziell); Standard: ./data/plugins
# Muss außerhalb von <App>/plugins liegen (dort liegen die offiziellen Plugins)
# PLUGINS_DIR=./data/plugins
# Intern: wird von "npm run plugin -- dev <Ordner>" gesetzt (Plugin-ID in Entwicklung, nur im Dev-Mock-Modus wirksam)
# PLUGINS_DEV_ID=
# true = DEMS startet ohne Plugin-Code, z. B. wenn ein Plugin den Start verhindert
# PLUGINS_SAFE_MODE=false
# Plugin-Upload: true = Admins dürfen in System › Plugins .dems-Pakete hochladen, ersetzen
# und entfernen (Standard: aus). DEMS prüft jedes Paket vorher (Dateien, Größe, Berechtigungen
# gegen den Code) und installiert erst nach Bestätigung mit dem ADMIN_RESET_PASSWORD; danach
# schaltet ein Admin das Plugin selbst ein. Hochgeladener Code läuft mit vollem Zugriff auf
# DEMS, den Bot und die Datenbank – nur einschalten, wenn ihr Plugins von Dritten nutzen wollt.
# Hochladen und Installieren sind im abgesicherten Modus gesperrt, Entfernen geht dort weiterhin.
# Nach einer Änderung den Container neu starten: docker compose up -d
# PLUGINS_UPLOAD=true

# Dev-Mock-Modus: DEMS ohne Discord und PostgreSQL mit Dummy-Daten (npm run dev:mock)
# npm run dev:mock setzt DEV_MOCK selbst — hier nur eintragen, wenn du den Modus
# auch mit "npm run dev" willst. Niemals in Produktion: mit NODE_ENV=production
# startet der Server dann nicht.
# Achtung: nur "npm run dev:mock" legt die Dummy-Daten automatisch an; mit
# "npm run dev" + DEV_MOCK=true vorher einmal "npm run dev:reset" ausführen.
# DEV_MOCK=true
# Optional: eigener Pfad für die Dev-Datenbank (Standard: ./data/dems.dev.sqlite)
# DEV_SQLITE_PATH=
# Optional: eigener Ordner für hochgeladene Banner im Mock-Modus (Standard: ./data/dev-uploads)
# DEV_UPLOAD_DIR=

# Docker-Dev: Port auf dem Host (compose.dev.yaml)
# DEMS_DEV_PORT=3000

# Nur für Tests (npm test): PostgreSQL für die Vertragstests; leer = diese Tests werden übersprungen.
# Eine eigene Testdatenbank eintragen – die Tests legen dort Schemas an und löschen sie wieder.
# TEST_DATABASE_URL=postgres://dems:passwort@localhost:5432/dems_test

# KI (optional)
# Leer lassen = KI aus (Standard): keine Blase, kein Button, kein /ask, keine ausgehenden Anfragen.
# Anbieter: ollama | openrouter | openai | gemini | anthropic (im Dev-Mock-Modus automatisch "mock")
AI_PROVIDER=
# Adresse der API; leer = Standardadresse des Anbieters (ein abschließender Schrägstrich wird entfernt)
AI_BASE_URL=
# API-Schlüssel; nur Ollama kommt ohne aus. Niemals in Antworten, Logs oder im Audit-Log.
AI_API_KEY=
# Modell für Mitglieder-Antworten, z. B. gpt-4o-mini
AI_MODEL=
# Optional: stärkeres Modell für Admin-Funktionen; leer = AI_MODEL
AI_MODEL_ADMIN=
# Windows mit Virenscanner, der HTTPS prüft (z. B. Kaspersky): DEMS mit "node --use-system-ca server.js"
# starten, sonst meldet die KI "Zertifikat wird nicht anerkannt" bzw. "nicht erreichbar".
